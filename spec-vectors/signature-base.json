        "path": "",
        "query": "",
        "headers": {}
      },
      "components": ["\"@authority\"", "\"@path\""],
      "signatureParams": "(\"@authority\" \"@path\")",
      "base": "\"@authority\": example.com\n\"@path\": /\n\"@signature-params\": (\"@authority\" \"@path\")"
    },
    {
      "name": "a non-standard method is preserved exactly, not uppercased",
      "request": {
        "method": "foo",
        "scheme": "https",
        "authority": "example.com",
        "path": "/",
        "query": "",
        "headers": {}
      },
      "components": ["\"@method\""],
      "signatureParams": "(\"@method\")",
      "base": "\"@method\": foo\n\"@signature-params\": (\"@method\")"
