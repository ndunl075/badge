{
  "description": "RFC 9421 signature base construction. Expected bases are written by hand, not generated, so they are an independent statement of what the bytes must be. Being hand-written does not make them right: the @method vector originally uppercased the method, and only a cross-check against a second implementation caught it. Any port of Badge must reproduce them exactly. LF line separators; no trailing newline.",
  "vectors": [
    {
      "name": "web-bot-auth minimum covered set",
      "request": {
        "method": "GET",
        "scheme": "https",
        "authority": "example.com",
        "path": "/",
        "query": "",
        "headers": {
          "signature-agent": "\"https://agent.example\""
        }
      },
      "components": ["\"@authority\"", "\"signature-agent\""],
      "signatureParams": "(\"@authority\" \"signature-agent\");created=1735689600;expires=1735689660;keyid=\"kPrK_qmxVWaYVA9wwBF6Iuo3vVzz7TxHCTwXBygrS4k\";alg=\"ed25519\";tag=\"web-bot-auth\"",
      "base": "\"@authority\": example.com\n\"signature-agent\": \"https://agent.example\"\n\"@signature-params\": (\"@authority\" \"signature-agent\");created=1735689600;expires=1735689660;keyid=\"kPrK_qmxVWaYVA9wwBF6Iuo3vVzz7TxHCTwXBygrS4k\";alg=\"ed25519\";tag=\"web-bot-auth\""
    },
    {
      "name": "authority is lowercased and the default https port dropped",
      "request": {
        "method": "GET",
        "scheme": "https",
        "authority": "Example.COM:443",
        "path": "/",
        "query": "",
        "headers": {}
      },
      "components": ["\"@authority\""],
      "signatureParams": "(\"@authority\");tag=\"web-bot-auth\"",
      "base": "\"@authority\": example.com\n\"@signature-params\": (\"@authority\");tag=\"web-bot-auth\""
    },
    {
      "name": "a non-default port is kept",
      "request": {
        "method": "GET",
        "scheme": "https",
        "authority": "example.com:8443",
        "path": "/",
        "query": "",
        "headers": {}
      },
      "components": ["\"@authority\""],
      "signatureParams": "(\"@authority\")",
      "base": "\"@authority\": example.com:8443\n\"@signature-params\": (\"@authority\")"
    },
    {
      "name": "derived components",
      "request": {
        "method": "POST",
        "scheme": "https",
        "authority": "example.com",
        "path": "/checkout/pay",
        "query": "cart=abc&ref=x%20y",
        "headers": {}
      },
      "components": [
        "\"@method\"",
        "\"@scheme\"",
        "\"@authority\"",
        "\"@path\"",
        "\"@query\"",
        "\"@request-target\"",
        "\"@target-uri\""
      ],
      "signatureParams": "(\"@method\" \"@scheme\" \"@authority\" \"@path\" \"@query\" \"@request-target\" \"@target-uri\")",
      "base": "\"@method\": POST\n\"@scheme\": https\n\"@authority\": example.com\n\"@path\": /checkout/pay\n\"@query\": ?cart=abc&ref=x%20y\n\"@request-target\": /checkout/pay?cart=abc&ref=x%20y\n\"@target-uri\": https://example.com/checkout/pay?cart=abc&ref=x%20y\n\"@signature-params\": (\"@method\" \"@scheme\" \"@authority\" \"@path\" \"@query\" \"@request-target\" \"@target-uri\")"
    },
    {
      "name": "an absent query is still a question mark",
      "request": {
        "method": "GET",
        "scheme": "https",
        "authority": "example.com",
        "path": "/a",
        "query": "",
        "headers": {}
      },
      "components": ["\"@query\""],
      "signatureParams": "(\"@query\")",
      "base": "\"@query\": ?\n\"@signature-params\": (\"@query\")"
    },
    {
      "name": "a query parameter is percent-decoded",
      "request": {
        "method": "GET",
        "scheme": "https",
        "authority": "example.com",
        "path": "/",
        "query": "a=1&b=hello%20world",
