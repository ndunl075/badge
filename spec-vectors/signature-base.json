      },
      "components": ["\"@query-param\";name=\"b\""],
      "signatureParams": "(\"@query-param\";name=\"b\")",
      "base": "\"@query-param\";name=\"b\": hello world\n\"@signature-params\": (\"@query-param\";name=\"b\")"
    },
    {
      "name": "repeated fields are joined in order and trimmed",
