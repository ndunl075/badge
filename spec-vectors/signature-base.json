      "components": ["\"x-thing\""],
      "signatureParams": "(\"x-thing\")",
      "base": "\"x-thing\": one  , two\n\"@signature-params\": (\"x-thing\")"
    },
    {
      "name": "http default port dropped",
      "request": {
        "method": "GET",
        "scheme": "http",
