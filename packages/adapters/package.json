{
  "name": "@badge/adapters",
  "version": "0.1.0",
  "description": "Thin Badge middleware adapters for node:http, Connect, Express, Fastify, Hono and fetch.",
  "license": "Apache-2.0",
  "keywords": [
    "web-bot-auth",
    "http-message-signatures",
    "rfc9421",
    "bot",
    "agent",
    "middleware",
    "ed25519"
  ],
  "homepage": "https://github.com/ndunl075/badge#readme",
  "bugs": {
    "url": "https://github.com/ndunl075/badge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndunl075/badge.git",
    "directory": "packages/adapters"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@badge/core": "workspace:*",
    "@badge/middleware": "workspace:*"
  },
  "devDependencies": {
    "@badge/policy": "workspace:*",
    "@badge/testkit": "workspace:*"
  }
}
